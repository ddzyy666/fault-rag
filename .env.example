APP_NAME=智能故障诊断助手
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
DATABASE_URL=sqlite+aiosqlite:///./fault_rag.db
# PostgreSQL示例：postgresql+asyncpg://fault_rag:password@localhost:5432/fault_rag
DATABASE_ECHO=false
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=20971520
DEFAULT_CHUNK_SIZE=700
DEFAULT_CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=80
MARKDOWN_INCLUDE_HEADING_PATH=false
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
QDRANT_PATH=qdrant_storage
QDRANT_COLLECTION=fault_diagnosis_chunks_v2
# 部署独立Qdrant时配置，例如：http://localhost:6333
QDRANT_URL=
# QDRANT_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash
# 请复制为 .env 后填写，禁止把真实Key提交到Git
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
RAG_MAX_CONTEXT_CHARS=12000
CONVERSATION_HISTORY_MESSAGES=10
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_CONTEXT_CHARS=48000
RERANKER_ENABLED=true
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# 留空时复用LLM_API_KEY
RERANKER_API_KEY=
RERANKER_TIMEOUT_SECONDS=30
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RRF_K=60
